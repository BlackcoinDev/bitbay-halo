ignore = 
    E262,E401,E711,E713,E731,E741,
    W291,W293,W605,
    F632,F821,F823,
    E501,W503,E203,E266,E265,E402,E722,E712,E721,
    F401,F403,F405,F811,F841,F824
# Full ignore list for legacy codebase compatibility
